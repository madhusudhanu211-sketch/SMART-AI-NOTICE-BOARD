# ==============================================================================
# Next-Generation Smart Notice Board — Environment Variables Template
# ==============================================================================
# Copy this file to .env in your root and backend directories for local setup.
# In GitHub Actions CI/CD, add sensitive keys to Repository Secrets (Settings -> Secrets).
# ==============================================================================

# ─── Application & Server Configuration ──────────────────────────────────────
PROJECT_NAME="Next-Generation Smart Notice Board"
API_V1_STR="/api"
PORT=8000
ENVIRONMENT="development"
DEBUG=True

# ─── URLs for Web & API ──────────────────────────────────────────────────────
BACKEND_URL="http://localhost:8000"
WEB_BASE_URL="http://localhost:5173"
APPIUM_SERVER_URL="http://127.0.0.1:4723"

# ─── Authentication & Security (REQUIRED IN PRODUCTION) ─────────────────────
# In GitHub Actions: Add as Secret JWT_SECRET_KEY
JWT_SECRET_KEY="replace-this-with-a-secure-random-secret-key-in-production"
SECRET_KEY="replace-this-with-a-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# ─── Database Configuration ──────────────────────────────────────────────────
# Default SQLite (no external setup required, created automatically):
DATABASE_URL="sqlite:///./smart_notice_board.db"
# PostgreSQL Example:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/smart_notice_board"

# ─── Test Accounts & Credentials ─────────────────────────────────────────────
# In GitHub Actions: Set these in GitHub Secrets or use seed defaults for testing
ADMIN_EMAIL="admin@smartnoticeboard.edu"
ADMIN_PASSWORD="Password123!"

FACULTY_EMAIL="faculty@smartnoticeboard.edu"
FACULTY_PASSWORD="Password123!"

STUDENT_EMAIL="student@smartnoticeboard.edu"
STUDENT_PASSWORD="Password123!"

# ─── AI & Cloud Integrations (Optional) ──────────────────────────────────────
# In GitHub Actions: Add as Secret GEMINI_API_KEY
GEMINI_API_KEY=""

# Cloudinary Storage (Optional)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ─── Appium / Mobile Test Configuration ──────────────────────────────────────
ANDROID_DEVICE_NAME="Android Emulator"
ANDROID_PLATFORM_VERSION="11.0"
APP_PACKAGE="com.smartnoticeboard.app"
APP_ACTIVITY=".MainActivity"
APP_PATH=""

